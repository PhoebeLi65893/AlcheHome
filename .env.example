APP_ENV=local
DATABASE_URL=postgresql+psycopg://alche:alche@localhost:5432/alche
# T4 authentication (copy this file to .env and fill in; .env is git-ignored)
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TTL_MIN=15
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# T6 AI intake: key from https://aistudio.google.com (leave empty to use the echo bot)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# T9 SMS (Twilio). For the local simulator only TWILIO_AUTH_TOKEN is needed (any value).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public https URL Twilio calls (e.g. your ngrok URL), used to check Twilio's signature
PUBLIC_BASE_URL=

# T11 dispatch: set to true to offer new tickets to handymen automatically
DISPATCH_AUTO=
# Optional: override the offer timeout in seconds (default 180 / 900 / 7200 by urgency)
DISPATCH_TIMEOUT_S=
